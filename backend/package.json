    "socket.io": "^4.8.1",
    "supertest": "^7.1.4",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.0.14",
    "nodemon": "^3.1.10",
